# Copy to .env and adjust if your backend runs somewhere other than
# http://localhost:5000 (see vite.config.ts's dev proxy, which forwards
# /api to VITE_API_PROXY_TARGET during `npm run dev`).
#
# In production (e.g. deploying to Vercel), point this at your deployed
# backend project's public URL + /api, e.g.:
#   VITE_API_URL=https://smart-farming-backend.vercel.app/api
VITE_API_URL=/api

# Optional: once you've recorded the Urdu how-to-use tutorial (script in
# ../docs/urdu-tutorial-script.md) and uploaded it to YouTube, paste its
# video ID here to embed it on the /how-to-use page. Leave blank until then
# — the page shows a friendly placeholder + the full written guide instead.
VITE_TUTORIAL_YOUTUBE_ID=
