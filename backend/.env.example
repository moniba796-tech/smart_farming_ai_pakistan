# Copy to .env and fill in your own values. Never commit the real .env file.

# --- Server ---
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# JWT signing secret for farmer/admin login sessions — use a long random
# string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change_this_to_a_long_random_string_in_production

# --- MongoDB Atlas ---
# Get this from Atlas: Database -> Connect -> Drivers -> copy connection string
# Replace <username>, <password>, and <db> (e.g. smart-farming-ai)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart-farming-ai?retryWrites=true&w=majority

# --- Free AI / data APIs ---
# Groq (free tier, no card required) -> https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier, no card required) -> https://aistudio.google.com/apikey
# Powers plant disease detection (gemini-2.5-flash: vision + reasoning in one call)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Hugging Face token — no longer required for disease detection (that now
# uses Gemini above), kept here only if you want to re-enable the old
# classifier fallback or use HF for something else in the future.
HF_TOKEN=your_huggingface_token_here
HF_DISEASE_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# OpenWeather (free tier) -> https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Nominatim (OpenStreetMap) reverse-geocoding is free and needs no key,
# but a descriptive User-Agent is required by their usage policy:
NOMINATIM_USER_AGENT=smart-farming-ai-pakistan/1.0
